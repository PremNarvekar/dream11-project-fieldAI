# FieldVision AI - Backend Environment Configuration Template
# Copy this file to backend/.env and populate with your production credentials

# Google Gemini API Key (keep secret; never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port and Host binding
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated, e.g. https://fieldvision-ai.netlify.app,http://localhost:5173 or * for local dev)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://fieldvision-ai.netlify.app
